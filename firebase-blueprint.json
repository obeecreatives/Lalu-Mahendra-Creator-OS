{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profile and workspace preferences for an authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name."
        },
        "activePhase": {
          "type": "string",
          "enum": ["phase-1", "phase-2", "phase-3"],
          "description": "Current active 90-day strategy phase."
        },
        "seededDefaultData": {
          "type": "boolean",
          "description": "Indicates whether starter blueprint items and portfolio vault were initialized."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "displayName", "activePhase", "seededDefaultData", "createdAt", "updatedAt"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Creator OS workspace ownership record and bounded list of authorized assistant Google emails.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerEmail": {
          "type": "string",
          "maxLength": 120
        },
        "ownerName": {
          "type": "string",
          "maxLength": 100
        },
        "activePhase": {
          "type": "string",
          "enum": ["phase-1", "phase-2", "phase-3"]
        },
        "assistantEmails": {
          "type": "array",
          "maxItems": 5,
          "description": "Bounded list (max 5) of verified lowercase Google emails granted assistant operational access."
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "ownerEmail", "ownerName", "activePhase", "assistantEmails", "createdAt", "updatedAt"]
    },
    "WorkspaceMember": {
      "title": "WorkspaceMember",
      "description": "Invited assistant collaborator record inside a creator workspace.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["assistant"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workspaceId", "ownerId", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "ContentItem": {
      "title": "ContentItem",
      "description": "Research-backed creator content unit spanning Research Gate, 3-30-15 Script Studio, Batching Stage, Publishing Queue, and Post-Publish Analytics.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sharedEmails": {
          "type": "array",
          "maxItems": 5
        },
        "lastEditedBy": {
          "type": "string",
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "pillar": {
          "type": "string",
          "enum": ["pilar-1", "pilar-2", "pilar-3", "pilar-4"]
        },
        "targetAccount": {
          "type": "string",
          "enum": [
            "@lalumahendra",
            "@obeecreatives",
            "@obeephotography",
            "Collab @lalumahendra x @obeephotography",
            "Collab @lalumahendra x @obeecreatives"
          ]
        },
        "format": {
          "type": "string",
          "enum": ["Reels", "Carousel", "TikTok", "IG Story", "Collab Reels"]
        },
        "stage": {
          "type": "string",
          "enum": ["research", "script", "batching", "editing", "ready", "published"]
        },
        "researchSource": {
          "type": "string",
          "maxLength": 240
        },
        "audienceTier": {
          "type": "string",
          "enum": ["lapis-1", "lapis-2", "lapis-3"]
        },
        "viralTrigger": {
          "type": "string",
          "enum": ["DM Shares", "Watch Time", "Saves", "Discussion"]
        },
        "researchInsight": {
          "type": "string",
          "maxLength": 1000
        },
        "hook3s": {
          "type": "string",
          "maxLength": 400
        },
        "body30s": {
          "type": "string",
          "maxLength": 3000
        },
        "cta15s": {
          "type": "string",
          "maxLength": 600
        },
        "carouselOutline": {
          "type": "string",
          "maxLength": 2500
        },
        "seoCaption": {
          "type": "string",
          "maxLength": 2200
        },
        "hashtags": {
          "type": "string",
          "maxLength": 200
        },
        "driveAssetUrl": {
          "type": "string",
          "maxLength": 500
        },
        "scheduledDate": {
          "type": "string",
          "maxLength": 30
        },
        "publishedUrl": {
          "type": "string",
          "maxLength": 500
        },
        "igPublishStatus": {
          "type": "string",
          "enum": ["manual", "queued", "draft", "published"]
        },
        "tiktokPublishStatus": {
          "type": "string",
          "enum": ["manual", "queued", "draft", "published"]
        },
        "sourcePortfolioRef": {
          "type": "string",
          "maxLength": 120
        },
        "views": { "type": "number" },
        "reach": { "type": "number" },
        "nonFollowerPct": { "type": "number" },
        "holdRate3s": { "type": "number" },
        "avgWatchPct": { "type": "number" },
        "shares": { "type": "number" },
        "saves": { "type": "number" },
        "comments": { "type": "number" },
        "profileVisits": { "type": "number" },
        "newFollows": { "type": "number" },
        "inboundLeads": { "type": "number" },
        "creatorMinutes": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "sharedEmails",
        "lastEditedBy",
        "title",
        "pillar",
        "targetAccount",
        "format",
        "stage",
        "researchSource",
        "audienceTier",
        "viralTrigger",
        "researchInsight",
        "hook3s",
        "body30s",
        "cta15s",
        "carouselOutline",
        "seoCaption",
        "hashtags",
        "driveAssetUrl",
        "scheduledDate",
        "publishedUrl",
        "igPublishStatus",
        "tiktokPublishStatus",
        "sourcePortfolioRef",
        "views",
        "reach",
        "nonFollowerPct",
        "holdRate3s",
        "avgWatchPct",
        "shares",
        "saves",
        "comments",
        "profileVisits",
        "newFollows",
        "inboundLeads",
        "creatorMinutes",
        "createdAt",
        "updatedAt"
      ]
    },
    "WeeklySnapshot": {
      "title": "WeeklySnapshot",
      "description": "Weekly evaluation scorecard log tracking retention, DM share rate, save rate, follow conversion, leads, and creator time efficiency.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sharedEmails": {
          "type": "array",
          "maxItems": 5
        },
        "lastEditedBy": {
          "type": "string",
          "maxLength": 120
        },
        "weekLabel": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "phase": {
          "type": "string",
          "enum": ["phase-1", "phase-2", "phase-3"]
        },
        "startDate": {
          "type": "string",
          "maxLength": 20
        },
        "endDate": {
          "type": "string",
          "maxLength": 20
        },
        "publishedCount": { "type": "number" },
        "totalViews": { "type": "number" },
        "totalReach": { "type": "number" },
        "avgNonFollowerPct": { "type": "number" },
        "avgHoldRate3s": { "type": "number" },
        "avgWatchPct": { "type": "number" },
        "totalShares": { "type": "number" },
        "totalSaves": { "type": "number" },
        "qualityCommentPct": { "type": "number" },
        "profileVisits": { "type": "number" },
        "newFollows": { "type": "number" },
        "inboundLeads": { "type": "number" },
        "ctaKeywordComments": { "type": "number" },
        "creatorHours": { "type": "number" },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "sharedEmails",
        "lastEditedBy",
        "weekLabel",
        "phase",
        "startDate",
        "endDate",
        "publishedCount",
        "totalViews",
        "totalReach",
        "avgNonFollowerPct",
        "avgHoldRate3s",
        "avgWatchPct",
        "totalShares",
        "totalSaves",
        "qualityCommentPct",
        "profileVisits",
        "newFollows",
        "inboundLeads",
        "ctaKeywordComments",
        "creatorHours",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "PortfolioAsset": {
      "title": "PortfolioAsset",
      "description": "Showcase work from @obeephotography or @obeecreatives tracked for 1-to-Many Reels recycling.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sharedEmails": {
          "type": "array",
          "maxItems": 5
        },
        "lastEditedBy": {
          "type": "string",
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "sourceAccount": {
          "type": "string",
          "enum": ["@obeephotography", "@obeecreatives"]
        },
        "category": {
          "type": "string",
          "maxLength": 60
        },
        "imagePath": {
          "type": "string",
          "maxLength": 300
        },
        "craftAngle": {
          "type": "string",
          "maxLength": 500
        },
        "recycledToReels": {
          "type": "boolean"
        },
        "linkedContentId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "sharedEmails",
        "lastEditedBy",
        "title",
        "sourceAccount",
        "category",
        "imagePath",
        "craftAngle",
        "recycledToReels",
        "linkedContentId",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profile and initialization state."
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Creator workspace record storing owner identity, 90-day active phase, and bounded assistant emails."
    },
    "/workspaces/{workspaceId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/WorkspaceMember" },
      "description": "Invited assistant records managed strictly by the workspace owner."
    },
    "/contentItems/{itemId}": {
      "schema": { "$ref": "#/entities/ContentItem" },
      "description": "Research-backed creator content pipeline items and per-post analytics shared with authorized assistants."
    },
    "/weeklySnapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/WeeklySnapshot" },
      "description": "Weekly evaluation scorecard snapshots across 90-day phases."
    },
    "/portfolioAssets/{assetId}": {
      "schema": { "$ref": "#/entities/PortfolioAsset" },
      "description": "Existing @obeephotography and @obeecreatives showcase works tracked for Reels recycling."
    }
  }
}
